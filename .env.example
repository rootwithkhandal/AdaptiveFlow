# API Keys
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-site.com   # optional
OPENROUTER_SITE_NAME=LLM Router             # optional

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# App
APP_ENV=production
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-48-character-or-longer-secret
ALLOWED_ORIGINS=["http://localhost:8000"]

# RL Router
EPSILON=0.1
EPSILON_DECAY=0.995
MIN_EPSILON=0.01

# Vector Memory
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_CONTEXT=3
MEMORY_BACKEND=faiss   # faiss or chroma
